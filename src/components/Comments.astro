<!--
  giscus 评论区（由旧版 blog 迁移）。
  空容器由内联脚本在客户端注入 giscus.app/client.js；
  data-astro-rerun 让脚本在每次 View-Transition 换页后重新执行注入。
  主题跟随 <html data-theme>；消息监听与 MutationObserver 只注册一次，
  切换亮/暗时通过 giscus.setConfig 即时跟随。
-->
<section class="giscus mx-auto mt-10 w-full" aria-label="评论区"></section>

<script is:inline data-astro-rerun>
  (() => {
    const themeNow = () =>
      document.documentElement.getAttribute("data-theme") === "dark"
        ? "transparent_dark"
        : "light";

    const sendConfig = config => {
      const iframe = document.querySelector("iframe.giscus-frame");
      iframe?.contentWindow?.postMessage(
        { giscus: config },
        "https://giscus.app"
      );
    };

    // 跨会话只注册一次：换页时 <html> 与 window 会被保留
    if (!window.__giscusSync) {
      window.__giscusSync = true;

      // giscus 就绪后按当前主题校正（覆盖加载期间发生过切换的情况）
      window.addEventListener("message", event => {
        if (event.origin !== "https://giscus.app") return;
        const data = event.data;
        if (data && data.giscus && data.giscus.id === "giscus:ready") {
          sendConfig({ setConfig: { theme: themeNow() } });
        }
      });

      // 监听亮/暗切换
      let lastTheme = themeNow();
      const observer = new MutationObserver(() => {
        const theme = themeNow();
        if (theme !== lastTheme) {
          lastTheme = theme;
          sendConfig({ setConfig: { theme } });
        }
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }

    const container = document.querySelector(".giscus");
    if (!container) return;
    // 换页后容器是新元素；仅在空容器上注入一次
    if (container.querySelector("iframe, script[src*='giscus.app']")) return;

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.setAttribute("data-repo", "sunbjt/blog");
    script.setAttribute("data-repo-id", "R_kgDORQWejw");
    script.setAttribute("data-category", "Announcements");
    script.setAttribute("data-category-id", "DIC_kwDORQWej84C2eQf");
    script.setAttribute("data-mapping", "pathname");
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "bottom");
    script.setAttribute("data-lang", "zh-CN");
    script.setAttribute("data-loading", "lazy");
    script.setAttribute("data-theme", themeNow());
    script.setAttribute("crossorigin", "anonymous");
    script.async = true;
    container.appendChild(script);
  })();
</script>
